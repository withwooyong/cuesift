{
  // globs를 명시하지 않으면 인자 없이 실행할 때 "Linting: 0 files"가 되어
  // 경고가 없는 것처럼 보인다. 반드시 대상을 지정한다.
  "globs": [
    "**/*.md"
  ],

  // .gitignore를 따른다. 이것이 없으면 .pytest_cache/README.md 같은
  // 로컬 생성물까지 검사해 로컬과 CI의 검사 대상이 어긋난다.
  "gitignore": true,

  // 서드파티 문서는 검사 대상이 아니다(.gitignore에도 있으나 명시한다).
  "ignores": [
    ".venv/**",
    "node_modules/**"
  ],
  "config": {
    "default": true,

    // MD013(줄 길이 80자) — 끈다.
    // 이 프로젝트의 문서는 한국어 산문과 넓은 표로 구성되며 렌더링해 읽는 것을
    // 전제한다. 80자에 맞춰 줄을 끊으면 표가 깨지고 문장 가독성이 떨어진다.
    "MD013": false,

    // MD036(강조를 제목처럼 사용) — 끈다.
    // "**S1 — 기본 시나리오**" 같은 라벨은 의도적으로 제목이 아니다.
    // 실제 제목으로 바꾸면 문서 목차가 시나리오 라벨로 오염된다.
    "MD036": false,

    // MD033(인라인 HTML) — <br>만 허용한다.
    // 마크다운 표 셀에서 줄바꿈을 넣을 다른 수단이 없다.
    "MD033": {
      "allowed_elements": ["br"]
    },

    // MD024(중복 제목) — 형제 관계일 때만 금지한다.
    // Keep a Changelog 형식은 버전 섹션마다 Added/Changed/Fixed를 반복하는
    // 것이 정의 그 자체다. 전면 금지하면 CHANGELOG.md를 쓸 수 없다.
    "MD024": {
      "siblings_only": true
    },

    // MD060(표 파이프 간격) — 셀에 여백을 두는 기존 관례에 맞춘다.
    "MD060": {
      "style": "padded"
    }
  }
}
